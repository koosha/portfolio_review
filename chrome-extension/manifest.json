{
  "manifest_version": 3,
  "name": "Local Portfolio · Yahoo connector",
  "version": "1.1.6",
  "minimum_chrome_version": "120",
  "description": "Connect Yahoo Finance in your normal Chrome session to your local portfolio app.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://finance.yahoo.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Local Portfolio"}
}
